# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# Credenciales de IA (Google Gemini)
GEMINI_API_KEY=

# Base de Datos PostgreSQL (Supabase)
DATABASE_URL=

# Integración Privada Bot <-> Kronos 2.0 (KRON2-152)
# Token Bearer privado exclusivo para /api/tickets, /api/tickets/:id, /api/metricas (distinto de Meta/Gemini)
TRIAGE_API_TOKEN=

# Consulta opcional de catálogo oficial en Kronos 2.0 (GET /api/kronos/catalogo, timeout 5000 ms)
KRONOS_API_BASE_URL=
KRONOS_CATALOGO_TOKEN=
KRONOS_CATALOGO_TIMEOUT_MS=5000

# Configuración del Servidor
PORT=3000
